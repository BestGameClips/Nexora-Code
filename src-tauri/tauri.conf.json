{
 "$schema": "https://schema.tauri.app/config/2",
 "productName": "Nexora Code",
 "version": "0.1.0",
 "identifier": "dev.nexora.code",
 "build": {
  "beforeDevCommand": "npm run dev",
  "devUrl": "http://localhost:1420",
  "beforeBuildCommand": "npm run build",
  "frontendDist": "../dist"
 },
 "app": {
  "windows": [
   {
    "label": "main",
    "title": "Nexora Code",
    "width": 1280,
    "height": 800,
    "minWidth": 800,
    "minHeight": 500,
    "decorations": false,
    "transparent": true
   }
  ],
  "security": {
   "csp": null
  }
 },
 "bundle": {
  "active": true,
  "targets": [
   "nsis"
  ],
  "icon": [
   "icons/icon.ico"
  ]
 }
}